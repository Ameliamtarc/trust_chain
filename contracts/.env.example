# Arbitrum Sepolia RPC endpoint
CHAIN_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc

# Dedicated test wallet private key. Never commit contracts/.env or share this value.
DEPLOYER_PRIVATE_KEY=0xREPLACE_WITH_64_HEX_CHARACTERS

# Optional: provide all four distinct wallet addresses to assign demo roles during deployment.
# Leave all four empty to deploy without assigning demo roles.
DEMO_NGO_WALLET=0xREPLACE_WITH_NGO_WALLET_ADDRESS
DEMO_VERIFIER_WALLET=0xREPLACE_WITH_VERIFIER_WALLET_ADDRESS
DEMO_AUDITOR_WALLET=0xREPLACE_WITH_AUDITOR_WALLET_ADDRESS
DEMO_ARBITRATOR_WALLET=0xREPLACE_WITH_ARBITRATOR_WALLET_ADDRESS
